FROM ubuntu:24.04 AS extractor

ARG MAGISK_APK_URL="https://github.com/topjohnwu/Magisk/releases/download/v30.7/Magisk-v30.7.apk"

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    unzip \
    && rm -rf /var/lib/apt/lists/*

RUN curl -sSL -o /tmp/magisk.apk "${MAGISK_APK_URL}"

RUN mkdir -p /dist/bin /dist/payload /dist/tmp /dist/workspace && \
    chmod 1777 /dist/tmp && \
    unzip -q /tmp/magisk.apk -d /tmp/extracted && \
    # x86_64 host tools
    for f in /tmp/extracted/lib/x86_64/lib*.so; do \
        base=$(basename "$f"); \
        name=${base#lib}; \
        name=${name%.so}; \
        install -m 755 "$f" "/dist/bin/$name"; \
    done && \
    for applet in $(/dist/bin/busybox --list); do \
        ln -sf busybox "/dist/bin/$applet"; \
    done && \
    # arm64-v8a target payload binaries
    for f in /tmp/extracted/lib/arm64-v8a/lib*.so; do \
        base=$(basename "$f"); \
        name=${base#lib}; \
        name=${name%.so}; \
        install -m 755 "$f" "/dist/payload/$name"; \
    done && \
    # Official assets
    cp /tmp/extracted/assets/* /dist/payload/ 2>/dev/null || true && \
    rm -rf /tmp/magisk.apk /tmp/extracted

FROM scratch

COPY --from=extractor /dist /

ENV PATH=/bin
ENV IS_CONTAINER=1
WORKDIR /workspace

CMD ["/bin/sh"]
